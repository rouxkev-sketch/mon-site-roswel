# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Liste détaillée générée par "npm install" (non suivie ici : les
# versions exactes sont déjà figées dans package.json)
package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# relevés des sondes (nº 174-§3) — écrits par /api/dev/journal-sonde,
# en développement uniquement. Ils appartiennent à la machine qui les a
# produits : jamais dans l'historique.
journal-*.txt

# le journal de bord (nº 272-§2) — écrit par /api/dev/journal-de-bord,
# à la racine : un relevé d'environnement, jamais un fichier du produit
journal-de-bord*.ndjson

# les sauvegardes de la base (nº 689) — écrites par `sh outils/sauvegarde`
# sur le Mac du propriétaire. Elles contiennent des DONNÉES PERSONNELLES
# (adresses, messages, comptes) : jamais dans l'historique, jamais dans
# un zip de livraison. Elles restent chez lui, et il les recopie sur un
# disque externe (voir outils/LISEZMOI-sauvegardes.md).
/sauvegardes/

#  Le journal de `outils/reprendre-le-cache` (nº 778) : il est écrit
#  au fil de l'eau dans le dossier du propriétaire pour qu'un compte
#  rendu survive à une fenêtre de terminal fermée. C'est une trace de
#  travail, pas un fichier du projet — elle ne rentre ni dans
#  l'historique, ni dans un zip.
/reprise-du-cache.txt

#  Le journal du diagnostic de cache (nº 779) — même raison que
#  celui de la reprise, juste au-dessus.
/diagnostic-cache.txt
