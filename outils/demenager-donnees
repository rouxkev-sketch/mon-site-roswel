#!/bin/sh
#
#  ██ COPIER LES LIGNES VERS LE NOUVEAU PROJET (passe nº 766) ██
#  ==================================================================
#  CE QUE TU TAPES, DANS LE DOSSIER DU PROJET, SUR TON MAC :
#
#    CIBLE_URL='https://xxxxx.supabase.co' \
#    CIBLE_SECRET_KEY='la clé secrète du NOUVEAU projet' \
#      sh outils/demenager-donnees
#
#  Il LIT et il COMPTE, il n'écrit rien. Quand le compte te va :
#
#    CIBLE_URL='…' CIBLE_SECRET_KEY='…' \
#      sh outils/demenager-donnees --reel
#
#  ⚠️ SUR TON MAC, PAS DANS L'ATELIER. L'atelier n'a aucun accès au
#  réseau : il ne peut joindre ni l'un ni l'autre des projets.
#
#  ==================================================================
#  OÙ TROUVER LES DEUX VALEURS DU NOUVEAU PROJET
#  ------------------------------------------------------------------
#  Dans supabase.com, projet « yokofolio-us » :
#    · CIBLE_URL         → Settings ▸ Data API ▸ « Project URL »
#    · CIBLE_SECRET_KEY  → Settings ▸ API Keys ▸ la clé SECRÈTE
#                          (`service_role` / « secret »), celle qu'on
#                          ne montre jamais et qui passe outre les
#                          règles de sécurité.
#  ⚠️ ELLES NE S'ÉCRIVENT DANS AUCUN FICHIER. Tapées sur la ligne de
#  commande, elles vivent le temps de la commande, et rien de plus.
#  N'écris JAMAIS la clé secrète dans le dépôt, ni dans un message.
#
#  ==================================================================
#  L'ORDRE DES OPÉRATIONS — celui-ci n'est pas le premier
#  ------------------------------------------------------------------
#   1. le SCHÉMA, LU DANS LA VRAIE BASE puis collé dans le nouveau
#      projet : `supabase/766-lire-le-schema-reel.sql` dans l'ancien,
#      « Download CSV », puis `sh outils/assembler-schema le.csv`, et
#      on colle le `supabase/yokofolio-schema-reel.sql` obtenu ;
#   2. l'EMPREINTE des deux projets comparée
#      (`supabase/766-empreinte-schema.sql` collé dans chacun) : tant
#      qu'elles diffèrent, ce script échouera. C'est ce contrôle-là qui
#      manquait à la première tentative ;
#   3. les COMPTES recréés (`sh outils/restaurer-comptes`) — sans eux,
#      la moitié des lignes sera refusée : elles pointent vers un
#      compte ;
#   4. CE SCRIPT, pour les lignes ;
#   5. les PHOTOS (`sh outils/demenager-photos`).
#  Tout est écrit pas à pas dans docs/DEMENAGEMENT-766.md.
#
#  ==================================================================
#  IL S'ARRÊTE À LA PREMIÈRE ERREUR
#  ------------------------------------------------------------------
#  Les treize dernières tables s'appuient sur les premières : si
#  `tatoueurs` échoue, tout le reste échouerait aussi. Il s'arrête donc
#  net et nomme la cause, plutôt que de dérouler treize messages pour
#  un seul vrai problème.
#  Pour tout voir d'un coup malgré tout : ajoute `--continuer`.
#
#  ==================================================================
#  CE QU'IL NE FAIT JAMAIS
#  ------------------------------------------------------------------
#  Il n'efface rien, ne modifie rien dans l'ANCIEN projet : il n'y
#  fait que des lectures. Dans le nouveau, il n'a qu'un verbe —
#  ajouter une ligne, ou la remplacer si elle existe déjà. Relancé
#  deux fois, il ne crée aucun doublon.
#

set -e

DOSSIER=$(cd "$(dirname "$0")/.." && pwd)
cd "$DOSSIER"

. "$(dirname "$0")/verifier-node.sh"

exec node outils/demenager-donnees.mjs "$@"
