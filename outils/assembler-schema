#!/bin/sh
#
#  ██ FAIRE LE FICHIER DU SCHÉMA RÉEL (passe nº 766 bis) ██
#  ==================================================================
#  CE QUE TU TAPES, DANS LE DOSSIER DU PROJET, SUR TON MAC :
#
#    sh outils/assembler-schema ~/Downloads/resultat.csv
#
#  Il écrit `supabase/yokofolio-schema-reel.sql`. C'est CE fichier-là
#  que tu colles dans le NOUVEAU projet.
#
#  ==================================================================
#  D'OÙ VIENT LE CSV
#  ------------------------------------------------------------------
#   1. Ouvre l'ANCIEN projet (Irlande) sur supabase.com ▸ SQL Editor.
#   2. Colle tout `supabase/766-lire-le-schema-reel.sql` et lance.
#      Il ne fait que LIRE : il ne modifie rien, ne touche à aucune
#      donnée, et ne regarde aucune clé.
#   3. Sous le résultat : bouton « Download CSV ».
#   4. Passe le fichier obtenu à cette commande.
#
#  ==================================================================
#  POURQUOI ON NE SE SERT PLUS DU SCHÉMA TIRÉ DU DÉPÔT
#  ------------------------------------------------------------------
#  Le premier schéma livré (nº 766) était bâti en rejouant les
#  migrations du dépôt. Il a échoué : la vraie base a des colonnes que
#  le dépôt n'a jamais connues — ajoutées à la main dans Supabase au
#  fil des passes. `filtres_motif` en est une.
#  Le dépôt n'est pas le miroir de la base. La base fait foi.
#
#  ==================================================================
#  CE QU'IL NE FAIT JAMAIS
#  ------------------------------------------------------------------
#  Il ne joint aucune base, aucun réseau. Il lit un fichier sur ton
#  disque et en écrit un autre à côté. Rien de plus.
#

set -e

DOSSIER=$(cd "$(dirname "$0")/.." && pwd)
cd "$DOSSIER"

. "$(dirname "$0")/verifier-node.sh"

exec node outils/assembler-schema.mjs "$@"
